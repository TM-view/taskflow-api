pipeline {
    agent {
        kubernetes {
            defaultContainer 'flutter'
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  namespace: jenkins-agents
spec:
  serviceAccountName: jenkins
  restartPolicy: Never
  containers:
  - name: flutter
    image: ghcr.io/cirruslabs/flutter:stable
    command: ['cat']
    tty: true
    resources:
      requests:
        cpu: 500m
        memory: 2Gi
      limits:
        cpu: '2'
        memory: 4Gi
  - name: osv
    image: ghcr.io/google/osv-scanner:v2.2.2
    command: ['cat']
    tty: true
    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        cpu: 500m
        memory: 512Mi
'''
        }
    }
    options {
        timeout(time: 45, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
    }
    stages {
        stage('Pub Get') {
            steps {
                dir('frontend') {
                    sh 'flutter pub get --enforce-lockfile'
                }
            }
        }
        stage('Parallel Quality Gates') {
            failFast true
            parallel {
                stage('Flutter Analyze') {
                    steps {
                        dir('frontend') {
                            sh 'flutter analyze --fatal-infos'
                        }
                    }
                }
                stage('Flutter Tests') {
                    steps {
                        dir('frontend') {
                            sh 'flutter test --coverage'
                        }
                    }
                    post {
                        always {
                            dir('frontend') {
                                archiveArtifacts artifacts: 'coverage/**', allowEmptyArchive: true
                            }
                        }
                    }
                }
                stage('OSV Dependency Scan') {
                    steps {
                        dir('frontend') {
                            container('osv') {
                                sh 'osv-scanner scan source -r .'
                            }
                        }
                    }
                }
            }
        }
        stage('Build Debug APK') {
            steps {
                dir('frontend') {
                    sh 'flutter build apk --debug'
                }
            }
            post {
                success {
                    dir('frontend') {
                        archiveArtifacts artifacts: 'build/app/outputs/flutter-apk/app-debug.apk', allowEmptyArchive: true
                    }
                }
            }
        }
        stage('Build Release AAB (Signed)') {
            when {
                branch 'main'
            }
            steps {
                dir('frontend') {
                    withCredentials([
                        file(credentialsId: 'android-keystore', variable: 'KEYSTORE_FILE'),
                        string(credentialsId: 'android-keystore-password', variable: 'KEYSTORE_PASSWORD'),
                        string(credentialsId: 'android-key-alias', variable: 'KEY_ALIAS'),
                        string(credentialsId: 'android-key-password', variable: 'KEY_PASSWORD')
                    ]) {
                        sh '''
                            cat <<EOF > android/key.properties
storeFile=${KEYSTORE_FILE}
storePassword=${KEYSTORE_PASSWORD}
keyAlias=${KEY_ALIAS}
keyPassword=${KEY_PASSWORD}
EOF
                            flutter build appbundle --release
                            rm -f android/key.properties
                        '''
                    }
                }
            }
            post {
                success {
                    dir('frontend') {
                        archiveArtifacts artifacts: 'build/app/outputs/bundle/release/*.aab', allowEmptyArchive: true
                    }
                }
            }
        }
    }
    post {
        success {
            emailext(
                to: '$DEFAULT_RECIPIENTS',
                subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "Branch: ${env.BRANCH_NAME ?: 'unknown'}\nCommit: ${env.GIT_COMMIT ?: 'unknown'}\nBuild: ${env.BUILD_URL}"
            )
        }
        failure {
            emailext(
                to: '$DEFAULT_RECIPIENTS',
                subject: "FAILURE: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "Branch: ${env.BRANCH_NAME ?: 'unknown'}\nCommit: ${env.GIT_COMMIT ?: 'unknown'}\nBuild: ${env.BUILD_URL}"
            )
        }
        always {
            echo 'Ephemeral Flutter agent pod released after run.'
        }
    }
}
