FROM ubuntu:22.04

ARG SSH_PUBLIC_KEY

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        openssh-server \
        python3 \
        python3-apt \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /run/sshd /root/.ssh \
    && ssh-keygen -A \
    && chmod 700 /root/.ssh \
    && printf '%s\n' "$SSH_PUBLIC_KEY" > /root/.ssh/authorized_keys \
    && chmod 600 /root/.ssh/authorized_keys \
    && printf '%s\n' 'PermitRootLogin prohibit-password' 'PubkeyAuthentication yes' 'PasswordAuthentication no' \
        > /etc/ssh/sshd_config.d/99-lab08.conf

EXPOSE 22 8080

CMD ["/usr/sbin/sshd", "-D", "-e"]
